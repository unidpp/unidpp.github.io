---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const {
  title,
  description = 'UniDPP: an open, international framework and reference implementation for the Digital Product Passport, spanning ISO/IEC, CEN, and UN standards.',
  eyebrow,
} = Astro.props;
const pageTitle = title === 'UniDPP' ? title : `${title} — UniDPP`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="canonical"
      href={`https://www.unidpp.org${Astro.url.pathname.replace(/index\.html$/, '')}`}
    />
    <style is:global>
      /* ------------------------------------------------------------------
         Design tokens. Semantic colours are semantic only:
         --green for valid/verified states, --red for verdicts/warnings.
         ------------------------------------------------------------------ */
      :root {
        --paper: #fafaf7;
        --ink: #1a2332;
        --navy: #14335c;
        --green: #1e6b4f;
        --red: #b4442c;
        --muted: #6b7686;
        --hairline: #e3e7ec;
        --radius: 6px;
        --prose: 72ch;
        --plate: 66rem;
        --font-body: 'Public Sans', -apple-system, 'Segoe UI', Roboto, sans-serif;
        --font-display: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
        --font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }

      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 400 1rem/1.65 var(--font-body);
      }

      /* Focus and links */
      :focus-visible {
        outline: 2px solid var(--navy);
        outline-offset: 2px;
      }
      a {
        color: var(--navy);
        text-underline-offset: 3px;
      }
      a:hover {
        color: var(--ink);
      }

      .skip {
        position: fixed;
        left: -100vw;
        top: 0;
        z-index: 20;
        background: var(--ink);
        color: var(--paper);
        padding: 0.5rem 0.9rem;
        font-size: 0.85rem;
        text-decoration: none;
      }
      .skip:focus-visible {
        left: 0;
        color: var(--paper);
      }

      /* Shell: depth rail on desktop (>=960px), single column below */
      .shell {
        min-height: 100vh;
      }
      @media (min-width: 960px) {
        .shell {
          display: grid;
          grid-template-columns: 16.5rem minmax(0, 1fr);
        }
      }
      .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
        width: 100%;
        max-width: var(--plate);
        margin: 0 auto;
        padding: 2.25rem 1.15rem 4.5rem;
      }
      @media (min-width: 640px) {
        main {
          padding: 3.25rem 2rem 5.5rem;
        }
      }

      /* Typography. Fraunces carries h1/h2 only; Public Sans does the work;
         IBM Plex Mono carries identifiers, MRZ, and tables of IDs. */
      h1,
      h2 {
        font-family: var(--font-display);
        font-optical-sizing: auto;
        font-weight: 500;
        line-height: 1.14;
        letter-spacing: -0.012em;
        text-wrap: balance;
      }
      h1 {
        font-size: clamp(1.9rem, 4.4vw, 2.75rem);
        margin: 0.4rem 0 1.1rem;
      }
      h2 {
        font-size: clamp(1.3rem, 2.4vw, 1.65rem);
        margin: 3rem 0 0.9rem;
      }
      h3 {
        font-size: 1.02rem;
        font-weight: 600;
        margin: 1.9rem 0 0.5rem;
      }
      p,
      ul,
      ol,
      dl,
      pre,
      .note {
        max-width: var(--prose);
      }
      p {
        margin: 0.9rem 0;
      }
      .lede {
        font-size: 1.12rem;
        line-height: 1.6;
        color: var(--muted);
        max-width: 64ch;
        margin: 0 0 2.25rem;
      }
      .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--navy);
        margin: 0 0 0.4rem;
      }
      .meta {
        color: var(--muted);
        font-size: 0.86rem;
      }

      /* Plates: wider sections (diagrams, tables) bounded by hairline rules.
         Plate and prose sections share one vertical rhythm: both boundaries
         land on 3rem, so the page reads as an even cadence. */
      .plate {
        border-top: 1px solid var(--hairline);
        border-bottom: 1px solid var(--hairline);
        padding: 1.6rem 0 1.9rem;
        margin: 3rem 0;
        max-width: none;
      }
      .plate > h2 {
        margin-top: 0.2rem;
      }

      /* Tables */
      .tablewrap {
        overflow-x: auto;
        max-width: none;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.875rem;
        margin: 1.1rem 0;
      }
      th,
      td {
        border: 1px solid var(--hairline);
        padding: 0.55rem 0.7rem;
        text-align: left;
        vertical-align: top;
      }
      th {
        font-weight: 600;
        color: var(--navy);
        border-top: 2px solid var(--navy);
      }
      caption {
        caption-side: bottom;
        text-align: left;
        color: var(--muted);
        font-size: 0.8rem;
        padding-top: 0.5rem;
      }
      /* Register tables: long factual listings (defect registers, fixture
         results) get a 2.5% navy tint on alternate rows for row tracking;
         the tint is the existing navy, not a new colour. */
      table.register tbody tr:nth-child(even) td {
        background: rgba(20, 51, 92, 0.025);
      }
      td code,
      th code {
        font-size: 0.82em;
        overflow-wrap: anywhere;
      }

      /* Code */
      code {
        font-family: var(--font-mono);
        font-size: 0.86em;
        background: rgba(20, 51, 92, 0.07);
        padding: 0.1em 0.35em;
        border-radius: 4px;
      }
      pre {
        background: #fff;
        border: 1px solid var(--hairline);
        border-radius: var(--radius);
        padding: 1rem 1.15rem;
        overflow: auto;
        font-size: 0.85rem;
        line-height: 1.6;
        max-width: var(--prose);
      }
      pre code {
        background: none;
        padding: 0;
        font-size: inherit;
      }

      /* Cards: hairline grid, no shadows */
      .cols {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
        gap: 1px;
        background: var(--hairline);
        border: 1px solid var(--hairline);
        border-radius: var(--radius);
        overflow: hidden;
        margin: 1.6rem 0;
        max-width: none;
      }
      .card {
        background: var(--paper);
        padding: 1.1rem 1.2rem;
      }
      .card h3 {
        margin: 0 0 0.55rem;
        font-size: 0.97rem;
      }
      .card p {
        margin: 0;
        font-size: 0.88rem;
        color: var(--muted);
      }
      .card .tag {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.66rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--navy);
        border: 1px solid var(--hairline);
        border-radius: 99px;
        padding: 0.14rem 0.6rem;
        margin: 0 0 0.7rem;
        background: #fff;
      }

      /* Notes and embeds */
      .note {
        border-left: 2px solid var(--navy);
        background: #fff;
        padding: 0.65rem 1rem;
        color: var(--muted);
        font-size: 0.9rem;
        margin: 1.6rem 0;
      }
      .embed {
        border: 1px dashed var(--muted);
        border-radius: var(--radius);
        background: #fff;
        padding: 2.5rem 1.25rem;
        text-align: center;
        color: var(--muted);
        margin: 1.6rem 0;
      }
      .embed .embed-title {
        font-weight: 600;
        color: var(--ink);
        font-size: 0.95rem;
        margin: 0 0 0.4rem;
      }
      .embed p {
        margin: 0 auto;
        font-size: 0.86rem;
        max-width: 34rem;
      }

      /* Semantic colour utilities (valid/verified; verdict/warning) */
      .ok {
        color: var(--green);
      }
      .neg {
        color: var(--red);
      }

      /* Visually hidden, still announced */
      .vh {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }

      /* Footer */
      footer.site {
        border-top: 1px solid var(--hairline);
        padding: 1.4rem 1.15rem;
        color: var(--muted);
        font-size: 0.8rem;
        display: flex;
        gap: 1.1rem;
        flex-wrap: wrap;
      }
      footer.site span {
        margin-right: auto;
      }
      footer.site a {
        color: var(--muted);
      }
      footer.site a:hover {
        color: var(--ink);
      }
      @media (min-width: 640px) {
        footer.site {
          padding: 1.4rem 2rem;
        }
      }

      /* Motion: respect reduced-motion globally */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <Nav />
      <div class="page">
        <main id="main">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
