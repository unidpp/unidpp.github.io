---
// Sticky header: section nav grouped by reading depth, search,
// dark-mode toggle, GitHub link. Below 1150px the nav collapses into
// a hamburger drawer (tier-labelled groups); above 1150px it renders
// inline with tier hairlines — the measured fit width for all 12 links.
const path = Astro.url.pathname.replace(/index\.html$/, '');
const isActive = (prefix: string) =>
  prefix === '/' ? path === '/' : path === prefix || path.startsWith(prefix + '/');

const tiers = [
  {
    label: 'Understand',
    items: [
      { label: 'Learn', href: '/learn/' },
      { label: 'Why', href: '/why/' },
    ],
  },
  {
    label: 'Framework',
    items: [
      { label: 'How it works', href: '/framework/' },
      { label: 'Specification', href: '/specs/' },
    ],
  },
  {
    label: 'Build',
    items: [
      { label: 'Implementation', href: '/implementation/' },
      { label: 'Compare', href: '/compare/' },
    ],
  },
  {
    label: 'Reference',
    items: [
      { label: 'Story', href: '/story/' },
      { label: 'Terminology', href: '/terminology/' },
      { label: 'Papers', href: '/papers/' },
      { label: 'Live', href: '/live/' },
    ],
  },
  {
    label: 'Participate',
    items: [
      { label: 'Community', href: '/community/' },
      { label: 'About', href: '/about/' },
    ],
  },
];
---

<header class="hdr">
  <div class="hdr-inner">
    <a class="wordmark" href="/" aria-label="UniDPP home">
      <span class="wm-a">uni</span><span class="wm-b">DPP</span>
    </a>

    <button
      id="menu-toggle"
      class="hbtn menu-toggle"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <svg class="icon-open" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>

    <nav class="secnav" id="site-nav" aria-label="Site sections by depth">
      {
        tiers.map((tier, ti) => (
          <span class:list={['tier', { first: ti === 0 }]}>
            <span class="tier-name" aria-hidden="true">{tier.label}</span>
            {
              tier.items.map((item) => (
                <a class:list={['sec', { current: isActive(item.href) }]} href={item.href}>
                  {item.label}
                </a>
              ))
            }
          </span>
        ))
      }
    </nav>

    <div class="hdr-actions">
      <button
        id="search-open"
        class="hbtn"
        aria-label="Search the site"
        title="Search"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
      </button>
      <button id="theme-toggle" class="hbtn" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a
        class="hbtn"
        href="https://github.com/unidpp"
        aria-label="UniDPP on GitHub"
        title="GitHub"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.26.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.807 1.305 3.492.997.108-.775.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.467-2.38 1.235-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 6 0c2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.804 5.625-5.476 5.92.43.372.814 1.102.814 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle')!;
  btn.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('unidpp-theme', dark ? 'dark' : 'light');
  });

  const menuBtn = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('site-nav')!;
  const html = document.documentElement;

  function closeMenu() {
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.setAttribute('aria-label', 'Open navigation menu');
    nav.classList.remove('open');
    html.classList.remove('nav-open');
  }

  menuBtn.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    menuBtn.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
    html.classList.toggle('nav-open', isOpen);
  });

  nav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  document.addEventListener('click', (e) => {
    if (html.classList.contains('nav-open') && !nav.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
      closeMenu();
    }
  });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .hdr-inner {
    max-width: var(--container);
    margin: 0 auto;
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1.15rem;
  }
  @media (min-width: 640px) {
    .hdr-inner {
      padding: 0 2rem;
    }
  }

  /* ── Mobile drawer (below 960px) ─────────────────────────── */
  .menu-toggle {
    display: grid;
  }
  .menu-toggle .icon-close { display: none; }
  :global(html.nav-open) .menu-toggle .icon-open { display: none; }
  :global(html.nav-open) .menu-toggle .icon-close { display: block; }

  .secnav {
    display: none;
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 49;
    background: var(--bg);
    border-top: 1px solid var(--border);
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0.75rem 1.15rem 2rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .secnav.open {
    display: flex;
  }

  /* Drawer tiers: stacked, each a labelled group */
  .tier {
    display: flex;
    flex-direction: column;
    padding: 0.65rem 0;
  }
  .tier + .tier {
    border-top: 1px solid var(--border);
  }
  .tier-name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
    margin: 0 0 0.3rem;
    padding: 0 0.62rem;
  }
  .sec {
    display: block;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    padding: 0.6rem 0.62rem;
    border-radius: var(--radius);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .sec:hover,
  .sec:focus-visible {
    color: var(--text);
    background: var(--accent-soft);
  }
  .sec.current {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }

  /* ── Inline nav (≥960px) ──────────────────────────────────── */
  @media (min-width: 1150px) {
    .menu-toggle,
    button.menu-toggle {
      display: none !important;
    }
    .secnav {
      display: flex;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: 0.05rem;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      flex: 1;
      min-width: 0;
      padding: 0.35rem 0;
      background: transparent;
      border: none;
    }
    .secnav::-webkit-scrollbar {
      display: none;
    }
    .tier {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      flex: 0 0 auto;
      padding: 0;
    }
    .tier + .tier {
      border-top: none;
      border-left: 1px solid var(--border);
      margin-left: 0.35rem;
      padding-left: 0.45rem;
    }
    .tier-name {
      display: none;
      font-size: 0.6rem;
      margin: 0 0.15rem 0 0;
      padding: 0;
    }
    .sec {
      display: inline-flex;
      font-size: 0.8rem;
      padding: 0.35rem 0.55rem;
      min-height: auto;
      white-space: nowrap;
    }
  }

  /* Tier names never appear inline: the 1200px container cannot hold
     12 links plus 5 eyebrow labels; they live in the drawer only. */

  .hdr-actions {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
  }
  .hbtn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: none;
    background: transparent;
    color: var(--text-2);
    border-radius: var(--radius);
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
  }
  .hbtn:hover {
    color: var(--text);
    background: var(--accent-soft);
  }
  .hbtn .icon-moon {
    display: none;
  }
  :global(html.dark) .hbtn .icon-sun {
    display: none;
  }
  :global(html.dark) .hbtn .icon-moon {
    display: block;
  }
</style>
