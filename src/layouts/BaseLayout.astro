---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.vue';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/400-italic.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '@fontsource/source-code-pro/400.css';
import '@fontsource/source-code-pro/500.css';
import '@fontsource/source-code-pro/600.css';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  /** When true, the page renders its own sidebar via the `rail` slot. */
  sectioned?: boolean;
}

const {
  title,
  description = 'UniDPP: an open, international framework and reference implementation for the Digital Product Passport, spanning ISO/IEC, CEN, and UN standards.',
  eyebrow,
  sectioned = false,
} = Astro.props;
const pageTitle = title === 'UniDPP' ? title : `${title} — UniDPP`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="canonical"
      href={`https://www.unidpp.org${Astro.url.pathname.replace(/index\.html$/, '')}`}
    />
    <meta name="theme-color" content="#14335c" />
    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash.
      const t = localStorage.getItem('unidpp-theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <Header />
      <main class:list={['page', { 'with-rail': sectioned }]} id="main">
        {sectioned && <div class="rail"><slot name="rail" /></div>}
        <div class="body-col">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <slot />
        </div>
      </main>
      <Footer />
    </div>

    <!-- Site search (pagefind): the island hydrates client:idle and
         opens from the header's plain trigger button. The index is
         built post-astro by `npm run build`; the module is imported
         lazily on first open. -->
    <SearchDialog client:idle />
  </body>
</html>

<style>
  .body-col {
    min-width: 0;
  }
</style>
