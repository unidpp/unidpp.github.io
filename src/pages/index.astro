---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSpread from '../components/HeroSpread.astro';
import MrzStrip from '../components/MrzStrip.astro';
import { news } from '../data/news';
---

<BaseLayout title="UniDPP">
  <div class="hero">
    <div class="hero-copy">
      <p class="hero-eyebrow mono">An international framework</p>
      <h1>One product passport, every jurisdiction's reading on top</h1>
      <p class="lede">
        UniDPP treats every regulatory regime — the European Union's EN&nbsp;18216–18246 series
        among them — as one profile on a neutral international core: one product identity, one
        append-only record, many jurisdiction, sector, and characteristic lenses, with trust that
        crosses borders without requiring anyone to adopt anyone else's rules.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/learn/">Start with the basics</a>
        <a class="btn btn-ghost" href="/specs/">Read the specification</a>
      </div>
      <p class="hero-note meta">
        For an executive summary, the proposal draft sits at <code>/papers/</code>; the open work
        is on <a href="https://github.com/unidpp">github.com/unidpp</a>.
      </p>
    </div>
    <div class="hero-motif">
      <HeroSpread />
    </div>
  </div>

  <MrzStrip />

  <section class="plate" aria-labelledby="initiative-h">
    <h2 id="initiative-h">The initiative at a glance</h2>
    <p>
      Six numbers a new reader needs, and nothing else — the count of work in progress; the count
      of stewards. One number is replaced as it stabilizes.
    </p>
    <div class="stats">
      <div class="stat">
        <span class="stat-num">5</span>
        <span class="stat-lbl">specification parts (WD)</span>
      </div>
      <div class="stat">
        <span class="stat-num">14</span>
        <span class="stat-lbl">design invariants</span>
      </div>
      <div class="stat">
        <span class="stat-num">8</span>
        <span class="stat-lbl">open repositories</span>
      </div>
      <div class="stat">
        <span class="stat-num">142</span>
        <span class="stat-lbl">verified concepts</span>
      </div>
      <div class="stat">
        <span class="stat-num">6</span>
        <span class="stat-lbl">contribution papers</span>
      </div>
      <div class="stat">
        <span class="stat-num">6</span>
        <span class="stat-lbl">steward bodies</span>
      </div>
    </div>
    <div class="cols initiative-cols" style="margin-top:1.6rem">
      <a class="card linkcard" href="/about/">
        <h3>About the initiative</h3>
        <p>Mission, multi-body stewardship, governance, licensing, and how to participate.</p>
      </a>
      <a class="card linkcard" href="/community/">
        <h3>Participate</h3>
        <p>Contribute code, file findings, or carry the work through your member body.</p>
      </a>
      <a class="card linkcard" href="https://github.com/unidpp">
        <h3>GitHub organization</h3>
        <p>Eight repositories: the core, four SDKs, resolver, trust, and explorer.</p>
      </a>
    </div>
  </section>

  <section class="plate" aria-labelledby="map-h">
    <h2 id="map-h">Read by depth</h2>
    <p class="lede">
      Five tiers, from plain language to participation. Each tier assumes the one before it. The
      newcomer path is the first tier; everything past it deepens.
    </p>
    <ol class="tiers">
      <li class="tier tier-01">
        <div class="tier-head">
          <span class="tier-num">01</span>
          <span class="tier-name">Understand</span>
        </div>
        <div class="tier-items">
          <a class="tier-link" href="/learn/">
            <h3>What a passport is</h3>
            <p>The washing-machine story, one diagram, and who reads a passport.</p>
          </a>
          <a class="tier-link" href="/why/">
            <h3>Why an international core</h3>
            <p>One laptop, five jurisdictions — one record instead of five.</p>
          </a>
        </div>
      </li>

      <li class="tier tier-02">
        <div class="tier-head">
          <span class="tier-num">02</span>
          <span class="tier-name">The framework</span>
        </div>
        <div class="tier-items">
          <a class="tier-link" href="/framework/">
            <h3>How it works</h3>
            <p>Six layers, fourteen invariants, the lens model, trust.</p>
          </a>
          <a class="tier-link" href="/specs/">
            <h3>The specification</h3>
            <p>The framework in normative form: five parts, working draft.</p>
          </a>
        </div>
      </li>

      <li class="tier tier-03">
        <div class="tier-head">
          <span class="tier-num">03</span>
          <span class="tier-name">Build</span>
        </div>
        <div class="tier-items">
          <a class="tier-link" href="/implementation/">
            <h3>Implementation</h3>
            <p>The open reference stack, demos, conformance register.</p>
          </a>
          <a class="tier-link" href="/compare/">
            <h3>Compared</h3>
            <p>freeDPP, OpenDPP, and UniDPP — capability table, sourced.</p>
          </a>
        </div>
      </li>

      <li class="tier tier-04">
        <div class="tier-head">
          <span class="tier-num">04</span>
          <span class="tier-name">Reference</span>
        </div>
        <div class="tier-items">
          <a class="tier-link" href="/terminology/">
            <h3>Terminology</h3>
            <p>The DPP vocabulary — 142 verified concepts, searchable.</p>
          </a>
          <a class="tier-link" href="/papers/">
            <h3>Contribution papers</h3>
            <p>Six papers for JTC 5 and partner bodies, with PDFs.</p>
          </a>
        </div>
      </li>

      <li class="tier tier-05">
        <div class="tier-head">
          <span class="tier-num">05</span>
          <span class="tier-name">Participate</span>
        </div>
        <div class="tier-items">
          <a class="tier-link" href="/community/">
            <h3>Community</h3>
            <p>Contributing, IPR, adopting, governance.</p>
          </a>
          <a class="tier-link" href="/about/">
            <h3>About</h3>
            <p>Mission, multi-body stewardship, licensing, contact.</p>
          </a>
        </div>
      </li>
    </ol>
  </section>

  <section class="plate" aria-labelledby="news-h">
    <h2 id="news-h">Latest</h2>
    <ol class="newslist">
      {
        news.map((item) => (
          <li>
            <a href={item.href}>
              <span class="news-date mono">{item.date}</span>
              <span class="news-body">
                <strong>{item.title}</strong>
                <span>{item.body}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  /* ── Hero: two-column at ≥900px, single below ──────────────── */
  .hero {
    display: grid;
    gap: 1.4rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
      gap: 2.4rem 3.2rem;
      padding-top: 0.8rem;
    }
    .hero-copy h1 {
      margin-top: 0.2rem;
    }
  }
  .hero-eyebrow {
    display: inline-block;
    margin: 0 0 0.55rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background: var(--accent-tint);
    border-radius: 99px;
    padding: 0.22rem 0.7rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin: 0 0 1.2rem;
  }
  .hero-note {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 56ch;
  }
  .hero-motif {
    min-width: 0; /* allow flex/grid to shrink */
  }

  .initiative-cols .linkcard {
    color: inherit;
    text-decoration: none;
  }
  .initiative-cols .linkcard:hover {
    background: var(--accent-tint);
  }
  .initiative-cols .linkcard:hover h3 {
    color: var(--accent);
  }

  /* ── Reading map: five tiered bands ───────────────────────── */
  .tiers {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    max-width: none;
    display: grid;
    gap: 0;
  }
  .tier {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    padding: 1.4rem 0 1.6rem;
    border-top: 1px solid var(--border);
    max-width: none;
  }
  .tier:last-child {
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 820px) {
    .tier {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 2.4rem;
      align-items: start;
    }
  }
  .tier-head {
    position: relative;
    padding-top: 0.2rem;
  }
  .tier-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
    line-height: 1;
    display: block;
  }
  .tier-name {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    margin-top: 0.5rem;
    display: block;
  }
  .tier-items {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .tier-link {
    display: block;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    min-height: 4.5rem;
  }
  .tier-link:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-tint);
  }
  .tier-link:hover h3 {
    color: var(--accent);
  }
  .tier-link h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .tier-link p {
    margin: 0;
    color: var(--text-2);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  /* ── News ─────────────────────────────────────────────────── */
  .newslist {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    max-width: none;
  }
  .newslist li + li {
    border-top: 1px solid var(--border);
  }
  .newslist a {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.85rem 0.2rem;
    text-decoration: none;
    color: inherit;
  }
  .newslist a:hover strong {
    color: var(--accent);
  }
  .news-date {
    font-size: 0.78rem;
    color: var(--text-2);
    padding-top: 0.15rem;
  }
  .news-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .news-body strong {
    font-weight: 600;
    font-size: 0.97rem;
  }
  .news-body > span {
    color: var(--text-2);
    font-size: 0.88rem;
    line-height: 1.55;
    max-width: 68ch;
  }
  @media (max-width: 560px) {
    .newslist a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
