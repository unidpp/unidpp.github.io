---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataTable from '../components/DataTable.astro';
import DocTerminal from '../components/DocTerminal.astro';

// The five canonical queries, verbatim against the loopback pilot.
const q1 = `curl -s http://127.0.0.1:8390/services | jq '.services | length'
# -> 8   (the C3 service descriptors the registry knows — who serves what)`;

const q2 = `curl -s 'http://127.0.0.1:8390/applicability?product_type=momiji:e8&at=2027-06-01T00:00:00Z' \\
  | jq '[.applicability[].binding.profile_item]'
# -> ["urn:unidpp:profile:jp-road-traffic"]

curl -s 'http://127.0.0.1:8390/applicability?product_type=momiji:e8&at=2028-06-01T00:00:00Z' \\
  | jq '[.applicability[].binding.profile_item]'
# -> ["urn:unidpp:profile:eu-machinery-battery", "urn:unidpp:profile:jp-road-traffic"]`;

const q3 = `curl -s -G 'http://127.0.0.1:8394/view' \\
  --data-urlencode 'passport=urn:unidpp:passport:pilot-e8-j000842' \\
  --data-urlencode 'profile=urn:unidpp:profile:pilot-jp-lens' \\
  --data-urlencode 'actor=importer' \\
  --data-urlencode 'at=2028-06-01T00:00:00Z' | jq '.coverage'
# -> elements_required 3, elements_present 2, complete false
#    the JP view reports de.jp.top-runner-class absent-as-of; the same
#    score the EU lens grades "A" the JP lens grades "class-2"`;

const q4 = `curl -s 'http://127.0.0.1:8395/en18222/v1/dppsByProductId/4006381333931?representation=full' \\
  | jq '.dppStatus'
# -> "active"   (the neutral core rendered in the EN 18222 field set —
#    a foreign protocol is a render profile, not a fork of the core)`;

const q5 = `curl -s http://127.0.0.1:8391/keyring | jq '{mode, roles: (.roles | keys)}'
# -> mode "seeded-dev", roles ["sign-ecdsa-p256", "sign-ed25519"]
#    every GET body is co-signed in the tree-head domain — the anchors
#    a verifier pins, published, not assumed`;

const runShell = `./stack.sh start     # build if needed, start 8390-8396, wait healthy
./seed-pilot.sh      # idempotent: seed the registry, produce demo/ artifacts
./stack.sh status    # per-service health, journal state, tunnel
./stack.sh stop      # stop everything — journals replay on next start`;
---

<BaseLayout
  title="Live pilot"
  description="The UniDPP reference pilot: the full service stack running as one unit — registry, trust, transparency log, issuer, projector, gateway, archive — with the seeded jurisdiction profiles, the two-lens demo, and the five canonical queries."
  eyebrow="Reference — pilot"
>
  <h1>The live pilot</h1>
  <p class="lede">
    The reference implementation runs as one stack on loopback ports 8390–8396:
    seven services, each an independent repository, wired together exactly the
    way the architecture prescribes — the issuer forwards registrations to the
    registry, the projector reads its lenses from the registry, the gateway
    renders the issuer's passports in foreign protocol shapes, and the archive
    anchors its notarized snapshots into the transparency log. The public URL
    <code>registry.unidpp.org</code> activates as soon as its DNS record lands;
    until then every query below runs against the loopback deployment.
  </p>

  <section id="stack" class="plate" aria-labelledby="stack-h">
    <h2 id="stack-h">The stack</h2>
    <p>
      One launcher builds and starts the whole unit, waits for each health
      endpoint, and adopts the existing tunnel. All state is append-only
      journals — stopping and restarting replays them; nothing is edited in
      place.
    </p>
    <DataTable
      columns={['Service', 'Port', 'Role', 'Health']}
      rows={[
        [
          '<a href="https://github.com/unidpp/unidpp-registry">unidpp-registry</a>',
          '8390',
          'ISO 19135 item and discovery registry — profiles, transforms, C3 services, C4 protocol bindings, C5 verification mechanisms, units',
          '<code>GET /healthz</code>',
        ],
        [
          '<a href="https://github.com/unidpp/unidpp-trust">unidpp-trust</a>',
          '8391',
          'Trust graph, keyring, trust lists, revocations (SIGNATIF)',
          '<code>GET /healthz</code>',
        ],
        [
          '<a href="https://github.com/unidpp/unidpp-log">unidpp-log</a>',
          '8392',
          'Transparency-log anchor service — RFC 6962 Merkle sequencing, signed inclusion receipts',
          '<code>GET /healthz</code>',
        ],
        [
          '<a href="https://github.com/unidpp/unidpp-issuer">unidpp-issuer</a>',
          '8393',
          'Passport lifecycle: create, typed events, Tier-A pack minting, verdicts',
          '<code>GET /healthz</code>',
        ],
        [
          '<a href="https://github.com/unidpp/unidpp-projector">unidpp-projector</a>',
          '8394',
          'Lens projection: a passport rendered under a registered profile, with coverage report',
          '<code>GET /healthz</code>',
        ],
        [
          '<a href="https://github.com/unidpp/unidpp-gateway">unidpp-gateway</a>',
          '8395',
          'Interop renders: UNTP verifiable-credential triad and EN 18222 REST',
          '<code>GET /healthz</code>',
        ],
        [
          '<a href="https://github.com/unidpp/unidpp-archive">unidpp-archive</a>',
          '8396',
          'Tier-C notarized snapshots (OAIS metadata, log-anchored)',
          '<code>GET /healthz</code>',
        ],
      ]}
      caption="The pilot registry additionally publishes at <code>registry.unidpp.org</code> through a Cloudflare named tunnel once DNS lands. The launcher verifies each port serves the right service before declaring it healthy."
    />
  </section>

  <section id="queries" class="plate" aria-labelledby="queries-h">
    <h2 id="queries-h">The five canonical queries</h2>
    <p>
      Five queries demonstrate the pilot end to end: discovery, point-in-time
      applicability, the two-lens projection, a foreign-protocol render, and
      the trust anchors a verifier pins. Each block is the verbatim command
      against the loopback deployment.
    </p>

    <DocTerminal
      label="query 01 — discovery"
      meta="GET /services · registry 8390"
      ariaLabel="Curl command listing the services the registry knows"
      text={q1}
      caption="The discovery layer registers descriptors of services and shapes, never records of things: operator keys are pinned per service, versions carry effective windows."
    />

    <DocTerminal
      label="query 02 — as-of applicability"
      meta="GET /applicability · registry 8390"
      ariaLabel="Curl command asking which profiles bind the product type at two instants"
      text={q2}
      caption="Adding a market is a dated binding, not a second passport: the same product type acquires the EU duty between the two instants, and every intermediate state is reconstructable."
    />

    <DocTerminal
      label="query 03 — two-lens view"
      meta="GET /view · projector 8394"
      ariaLabel="Curl command projecting one passport under the JP lens"
      text={q3}
      caption="The lens is a registered, versioned profile item; the projector executes its manifest and reports coverage honestly — disagreement between lenses is auditable, never merged away."
    />

    <DocTerminal
      label="query 04 — EN 18222 render"
      meta="GET /en18222/v1/dppsByProductId · gateway 8395"
      ariaLabel="Curl command requesting the EN 18222 render of a passport"
      text={q4}
      caption="The gateway renders the same passports a UNTP consumer reads as a verifiable-credential triad; its verdict leg verifies the issuer's real event signatures."
    />

    <DocTerminal
      label="query 05 — trust keyring"
      meta="GET /keyring · trust 8391"
      ariaLabel="Curl command fetching the trust anchors a verifier pins"
      text={q5}
      caption="Dev mode uses deterministic seeds so demos are reproducible; production replaces the keyring with an external trust list and environment-held keys."
    />
  </section>

  <section id="as-of" class="plate" aria-labelledby="asof-h">
    <h2 id="asof-h">One query, two answers: jurisdiction by date</h2>
    <p>
      The pilot's headline query binds the EU and JP jurisdiction profiles to
      one product type with different effective dates. The registry answers
      the question a customs officer actually asks — <em>what applied to this
      type on that date?</em> — from dated bindings alone:
    </p>
    <DataTable
      columns={['Instant', 'Profiles in force for <code>momiji:e8</code>', 'What changed']}
      rows={[
        [
          '<code>2027-06-01</code>',
          '<code>urn:unidpp:profile:jp-road-traffic</code>',
          'JP road-traffic duty only (effective 2027-04-01); the machine is legally a Japanese e-bike.',
        ],
        [
          '<code>2028-06-01</code>',
          '<code>urn:unidpp:profile:eu-machinery-battery</code>, <code>urn:unidpp:profile:jp-road-traffic</code>',
          'The EU machinery/battery duty is additionally in force (effective 2028-02-01) — same identity, same journal, a second lens mounted by a dated binding.',
        ],
      ]}
      caption="Verified query output from the running pilot; the JSON responses are archived as demo artifacts (<code>10-applicability-2027-06-01.json</code>, <code>11-applicability-2028-06-01.json</code>)."
    />
  </section>

  <section id="artifacts" class="plate" aria-labelledby="artifacts-h">
    <h2 id="artifacts-h">What a seeded run produces</h2>
    <p>
      A single idempotent script seeds the registry (ten register items —
      seven material-loop profiles, the two jurisdiction profiles, one
      equivalence transform — plus the dated bindings and the discovery
      dataset), issues a demonstration passport through the live issuer,
      mints and verifies its Tier-A pack, notarizes a Tier-C snapshot into
      the transparency log, and projects the EU and JP views of the same
      passport. Every step leaves a JSON artifact:
    </p>
    <DataTable
      columns={['Artifact', 'Contents']}
      rows={[
        ['<code>01–02</code>', 'The passport created over the issuer API and its document view after five typed events (issuance, corrections, a BMS milestone record).'],
        ['<code>03–05</code>', "The server-minted Tier-A pack (QR v15-M, 363 bytes), the issuer keyring, and the CLI verifier's offline verdict — pass, three readings, full coverage."],
        ['<code>06</code>', 'The Tier-C notarized snapshot, anchored in the transparency log (receipt id, tree size, root included).'],
        ['<code>07</code>', 'The two-lens views: EU complete at 3/3 with reparability class A; JP at 2/3, converting 0.72 kWh to 2.592 MJ and grading the same score class-2.'],
        ['<code>08–09</code>', 'The gateway renders: the UNTP verifiable-credential triad from the live issuer (five event signatures verified) and the EN 18222 REST render.'],
        ['<code>10–11</code>', 'The as-of applicability proofs tabulated above.'],
      ]}
    />
  </section>

  <section id="run" class="plate" aria-labelledby="run-h">
    <h2 id="run-h">Run it yourself</h2>
    <p>
      The pilot launcher lives in the
      <a href="https://github.com/unidpp">github.com/unidpp</a> workspace; the
      service repositories build with <code>cargo build --release</code> and
      run with environment wiring only — no database, no container required
      (a compose sketch documents the containerized form). From the pilot
      directory:
    </p>
    <DocTerminal
      label="shell"
      meta="from the pilot directory (github.com/unidpp workspace)"
      ariaLabel="Commands to launch the pilot stack and seed it"
      text={runShell}
    />
    <p class="cta-row">
      <a class="btn btn-primary" href="/implementation/demos/">Core demonstrations</a>
      <a class="btn btn-ghost" href="/story/">The E8 story</a>
      <a class="btn btn-ghost" href="https://github.com/unidpp">github.com/unidpp</a>
    </p>
  </section>
</BaseLayout>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }
</style>
