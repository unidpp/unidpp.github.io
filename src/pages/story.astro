const runShell = `git clone https://github.com/unidpp/unidpp-e2e
cd unidpp-e2e
make demo                     # the full E8 thread, B1–B10

# one beat at a time — same fixtures, same seeds
unidpp demo bike build        # B1–B2  assembly, part duties
