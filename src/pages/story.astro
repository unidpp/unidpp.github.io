// One figure = one diagram file in public/story/ (960×540 throughout).
interface Figure {
  src: string;
  alt: string;
  caption: string;
}
interface Beat {
  id: string;
  num: string;
  title: string;
  kicker: string;
  body: string;
  carried: string;
  figures: Figure[];
}

