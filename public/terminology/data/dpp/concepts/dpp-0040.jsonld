{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0040","@type":"skos:Concept","skos:notation":"dpp-0040","skos:prefLabel":{"eng":"consumer"},"skos:definition":{"eng":"individual member of the general public purchasing or using goods, property or services for private purposes"}}