{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0015","@type":"skos:Concept","skos:notation":"dpp-0015","skos:prefLabel":{"eng":"resolution"},"skos:definition":{"eng":"process in which an identifier is translated or mapped to another identifier, associated information or metadata about the object it represents"}}