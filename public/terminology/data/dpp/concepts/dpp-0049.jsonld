{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0049","@type":"skos:Concept","skos:notation":"dpp-0049","skos:prefLabel":{"eng":"supplier"},"skos:definition":{"eng":"company or company function that produces non final products (accessories, fabrics, yarns…); its industrial process has in input materials and in output components for the business customers"}}