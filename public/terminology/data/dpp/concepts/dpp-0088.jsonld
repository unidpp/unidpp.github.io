{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0088","@type":"skos:Concept","skos:notation":"dpp-0088","skos:prefLabel":{"eng":"semantic interoperability"},"skos:definition":{"eng":"ability for data shared by systems to be understood at the level of fully defined domain concepts"}}