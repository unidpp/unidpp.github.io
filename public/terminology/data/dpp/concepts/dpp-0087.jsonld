{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0087","@type":"skos:Concept","skos:notation":"dpp-0087","skos:prefLabel":{"eng":"interoperability"},"skos:definition":{"eng":"capability of two or more entities to exchange items in accordance with a set of rules and mechanisms implemented by an interface in each entity, in order to perform their specified tasks"},"skos:scopeNote":{"eng":"EN 18219:2026 defines “interoperability” from ISO/IEC 22123-1:2023 with a different formulation; see concept dpp-0086."}}