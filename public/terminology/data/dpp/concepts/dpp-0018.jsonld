{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0018","@type":"skos:Concept","skos:notation":"dpp-0018","skos:prefLabel":{"eng":"unique facility identifier"},"skos:definition":{"eng":"unique string of characters for the identification of location or building involved in a product's value chain or used by actors involved in a product's value chain"}}