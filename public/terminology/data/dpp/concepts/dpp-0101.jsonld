{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0101","@type":"skos:Concept","skos:notation":"dpp-0101","skos:prefLabel":{"eng":"capability"},"skos:definition":{"eng":"implementation-independent potential of a component to achieve an effect within a domain"},"skos:scopeNote":{"eng":"Capabilities can be orchestrated and structured hierarchically."}}