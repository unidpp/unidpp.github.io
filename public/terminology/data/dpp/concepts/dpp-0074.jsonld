{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0074","@type":"skos:Concept","skos:notation":"dpp-0074","skos:prefLabel":{"eng":"secure communication"},"skos:definition":{"eng":"mechanism of transmitting data between systems in a way that ensures its confidentiality, integrity and authenticity"}}