{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0050","@type":"skos:Concept","skos:notation":"dpp-0050","skos:prefLabel":{"eng":"yarn producer"},"skos:definition":{"eng":"company or company function that produces yarns from raw material; it has mainly Fabric and Knitwear producers as customers (Apparel Producers sometimes)"}}