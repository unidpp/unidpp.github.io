  <text>
    <body>
      <conceptEntry id="dpp-0052">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>company or company function that organizes manufacturing and material supplying to obtain finished garments from fabrics. It is a client of Fabric Producer and partially of Yarn Producer</p>
          </descrip>
          <ref>CWA 18291:2025 3.18</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
