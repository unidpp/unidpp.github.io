{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0007","@type":"skos:Concept","skos:notation":"dpp-0007","skos:prefLabel":{"eng":"Unique Identifier"},"skos:definition":{"eng":"identifier which is guaranteed to be unique among all identifiers used for those objects and for a specific purpose"},"skos:scopeNote":{"eng":"For more information, see ISO/IEC 15459-1."}}