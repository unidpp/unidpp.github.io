      <conceptEntry id="dpp-0110">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>executable realization of a function</p>
          </descrip>
          <note type="note">The term method is synonymous to operation.</note>
          <note type="note">An operation has a name and a list of parameters [ISO 19119:2005, 4.1.3].</note>
          <ref>IDTA-01001-3.2:2026 (Specification of the Asset Administration Shell — Part 1: Metamodel) 1.1.17</ref>
          <ref>Glossary Industrie 4.0</ref>
      </languageSection>
      </conceptEntry>
