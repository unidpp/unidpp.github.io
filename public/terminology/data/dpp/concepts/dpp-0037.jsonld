{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0037","@type":"skos:Concept","skos:notation":"dpp-0037","skos:prefLabel":{"eng":"issuing agency"},"skos:definition":{"eng":"organisation entrusted by a Registration Authority (RA) to manage unique identification schemes"}}