{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0002","@type":"skos:Concept","skos:notation":"dpp-0002","skos:prefLabel":{"eng":"controlled DPP data"},"skos:definition":{"eng":"information on digital product passport whose access is controlled based on the user's access rights"},"skos:scopeNote":{"eng":"User in the sense of a person who interacts with a system, product or service."}}