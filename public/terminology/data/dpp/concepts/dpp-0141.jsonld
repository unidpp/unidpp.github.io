{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0141","@type":"skos:Concept","skos:notation":"dpp-0141","skos:prefLabel":{"eng":"trigger predicate"},"skos:definition":{"eng":"declared component of a profile stating the conditions under which the profile applies, evaluated against the facts of the digital twin rather than against who declares them"},"skos:scopeNote":{"eng":"Characteristic profiles (concept dpp-0125) attach by predicate on twin facts — age, material content, heritage status, market status — rather than by law-of-place or industry."}}