{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0085","@type":"skos:Concept","skos:notation":"dpp-0085","skos:prefLabel":{"eng":"electronically signed data construct"},"skos:definition":{"eng":"structured data set containing the header, payload, signature and optional data fields"},"skos:scopeNote":{"eng":"The payload type and issuer identity are included in the header."}}