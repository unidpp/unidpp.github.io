{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0059","@type":"skos:Concept","skos:notation":"dpp-0059","skos:prefLabel":{"eng":"life cycle"},"skos:definition":{"eng":"consecutive and interlinked stages of a product system, from raw material acquisition or generation from natural resources to final disposal"}}