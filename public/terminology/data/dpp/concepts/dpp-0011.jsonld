{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0011","@type":"skos:Concept","skos:notation":"dpp-0011","skos:prefLabel":{"eng":"domain"},"skos:definition":{"eng":"specified area of knowledge, application, or activity within which a unique identifier is used"}}