  <text>
    <body>
      <conceptEntry id="dpp-0070">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>traceable asset is any product or material (individually, in batches, or in trade units) that needs to be tracked along a value chain</p>
          </descrip>
          <ref>CWA 18291:2025 3.2</ref>
          <ref>UNECE Recommendation No. 46</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
