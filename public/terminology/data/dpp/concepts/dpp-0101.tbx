  <text>
    <body>
      <conceptEntry id="dpp-0101">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>implementation-independent potential of a component to achieve an effect within a domain</p>
          </descrip>
          <note type="note">Capabilities can be orchestrated and structured hierarchically.</note>
          <note type="note">Capabilities can be made executable via services.</note>
          <note type="note">The impact manifests itself in a measurable effect within the physical world.</note>
          <ref>IDTA-01001-3.2:2026 (Specification of the Asset Administration Shell — Part 1: Metamodel) 1.1.7</ref>
          <ref>Glossary Industrie 4.0</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
