      <conceptEntry id="dpp-0002">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>information on digital product passport whose access is controlled based on the user's access rights</p>
          </descrip>
          <note type="note">User in the sense of a person who interacts with a system, product or service.</note>
          <ref>EN 18239 (prEN 18239:2025) 3.1</ref>
          <ref>EN 18216:2026 3.8</ref>
      </languageSection>
      </conceptEntry>
