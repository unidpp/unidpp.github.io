{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0068","@type":"skos:Concept","skos:notation":"dpp-0068","skos:prefLabel":{"eng":"traceability"},"skos:definition":{"eng":"ability to trace the history, application or location of an object in a value chain"}}