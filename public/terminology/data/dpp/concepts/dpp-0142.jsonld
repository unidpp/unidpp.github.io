{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0142","@type":"skos:Concept","skos:notation":"dpp-0142","skos:prefLabel":{"eng":"installation"},"skos:definition":{"eng":"typed structural relationship, and its event class, between a parent passport and an installed child component, recorded with method, slot identity, pairing, alterations, performer and time, which makes an installed component a different legal object from the standalone one"},"skos:scopeNote":{"eng":"Schema: install(child, parent, {method, slotId, pairing: none|firmware|key|module, alteration[], performedBy, at})."}}