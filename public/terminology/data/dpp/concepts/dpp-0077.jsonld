{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0077","@type":"skos:Concept","skos:notation":"dpp-0077","skos:prefLabel":{"eng":"cyber resilience"},"skos:definition":{"eng":"ability to maintain business continuity despite adverse conditions, attacks, or compromises on critical data flow and related information systems"}}