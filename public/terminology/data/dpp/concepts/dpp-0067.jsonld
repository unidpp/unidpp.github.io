{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0067","@type":"skos:Concept","skos:notation":"dpp-0067","skos:prefLabel":{"eng":"closed loop system"},"skos:definition":{"eng":"system by which products or resources are used and then recovered and turned into new products or recovered resources, without losing their inherent properties"}}