@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0101>
  a skos:Concept ;
  skos:notation "dpp-0101" ;
  skos:prefLabel "capability"@eng ;
  skos:definition "implementation-independent potential of a component to achieve an effect within a domain"@eng ;
  skos:scopeNote "Capabilities can be orchestrated and structured hierarchically."@eng ;
  skos:scopeNote "Capabilities can be made executable via services."@eng ;
  skos:scopeNote "The impact manifests itself in a measurable effect within the physical world."@eng
 .