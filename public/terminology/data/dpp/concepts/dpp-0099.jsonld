{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0099","@type":"skos:Concept","skos:notation":"dpp-0099","skos:prefLabel":{"eng":"Asset Administration Shell"},"skos:altLabel":{"eng":"AAS"},"skos:definition":{"eng":"standardized digital representation of an asset"},"skos:scopeNote":{"eng":"Asset Administration Shell and Administration Shell are used synonymously."}}