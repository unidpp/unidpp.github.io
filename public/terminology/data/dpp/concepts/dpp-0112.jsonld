{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0112","@type":"skos:Concept","skos:notation":"dpp-0112","skos:prefLabel":{"eng":"qualifier"},"skos:definition":{"eng":"well-defined element associated with a property instance or SubmodelElement, restricting the value statement to a certain period of time or use case"},"skos:scopeNote":{"eng":"Qualifiers can have associated values."}}