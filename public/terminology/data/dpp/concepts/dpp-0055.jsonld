{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0055","@type":"skos:Concept","skos:notation":"dpp-0055","skos:prefLabel":{"eng":"recycler"},"skos:definition":{"eng":"company or company function that performs activities to obtain recovered resources for use in a process or a product, excluding energy recovery"},"skos:scopeNote":{"eng":"Activities to obtain resources include activities such as recovery, collection, transport, sorting, cleaning, and re-processing."}}