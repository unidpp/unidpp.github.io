@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0007>
  a skos:Concept ;
  skos:notation "dpp-0007" ;
  skos:prefLabel "Unique Identifier"@eng ;
  skos:definition "identifier which is guaranteed to be unique among all identifiers used for those objects and for a specific purpose"@eng ;
  skos:scopeNote "For more information, see ISO/IEC 15459-1."@eng ;
  skos:scopeNote "Harmonization note (UniDPP): EN 18219:2026 and EN 18220:2026 define “unique identifier” as a string of characters required to be unique; see concept dpp-0006."@eng
 .