  <text>
    <body>
      <conceptEntry id="dpp-0085">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>structured data set containing the header, payload, signature and optional data fields</p>
          </descrip>
          <note type="note">The payload type and issuer identity are included in the header.</note>
          <note type="note">An ESDC is a machine-readable code.</note>
          <note type="note">An ESDC can contain non-signed data elements.</note>
          <ref>EN 18246 (prEN 18246:2025) 3.1</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
