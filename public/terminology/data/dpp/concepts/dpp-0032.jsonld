{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0032","@type":"skos:Concept","skos:notation":"dpp-0032","skos:prefLabel":{"eng":"economic operator"},"skos:definition":{"eng":"manufacturer, authorized representative, importer, distributor, dealer or fulfilment service provider that places the product on the market"},"skos:scopeNote":{"eng":"Harmonization note (UniDPP): EN 18221:2026 defines “economic operator” without the placing-on-the-market qualifier; see concept dpp-0033."}}