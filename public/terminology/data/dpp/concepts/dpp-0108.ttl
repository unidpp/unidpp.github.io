@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0108>
  a skos:Concept ;
  skos:notation "dpp-0108" ;
  skos:prefLabel "instance"@eng ;
  skos:definition "concrete, clearly identifiable component of a certain type"@eng ;
  skos:scopeNote "An individual entity of a type, for example a device, is obtained by defining specific property values."@eng ;
  skos:scopeNote "In an object-oriented view, an instance denotes an object of a class (of a type)."@eng
