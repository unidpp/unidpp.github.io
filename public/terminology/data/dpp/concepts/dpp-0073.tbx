<tbx style="dca" type="TBX-Basic" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
  <tbxHeader>
    <fileDesc>
      <source>https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0073</source>
    </fileDesc>
  </tbxHeader>
  <text>
    <body>
      <conceptEntry id="dpp-0073">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>property that data has not been altered or destroyed in an unauthorised manner</p>
          </descrip>
          <note type="note">In the context of secure communication, data integrity ensures that data transmitted between parties remains unaltered and intact from the moment it leaves the sender to the moment it reaches the receiver. This means that the data has not been tampered with, modified, or corrupted during transmission – whether accidentally or through malicious actions.</note>
          <ref>EN 18216:2026 3.5</ref>
          <ref>ISO 7498-2:1989 3.3.21</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
