{"@context":"https://glossarist.org/ns/context.jsonld","@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0123","@type":"gl:Concept","gl:identifier":"dpp-0123","gl:localizedConcept":{"eng":{"@id":"https://www.glossarist.org/dpp/dpp/concept/dpp-0123/eng","@type":"gl:LocalizedConcept","gl:languageCode":"eng","gl:designation":[{"@type":"gl:Expression","gl:normativeStatus":"preferred","gl:term":"mass balance model"}],"gl:definition":[{"@type":"gl:DetailedDefinition","gl:content":"chain of custody model in which materials or products with a set of specified characteristics are mixed according to defined criteria with materials or products without that set of characteristics"}],"gl:notes":[{"@type":"gl:DetailedDefinition","gl:content":"The proportion of the input with specified characteristics can only match the initial proportions on average and will typically vary across different outputs."}],"gl:source":[{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"CWA 18291:2025","gl:id":"3.28"}}},{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:sourceStatus":"identical","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"ISO 22095:2020","gl:id":"3.3.4"}}}]}},"gl:status":"valid","gl:domain":[{"@type":"gl:ConceptReference","gl:conceptId":"section-measurement","gl:source":"urn:unidpp:dpp","gl:refType":"section"}]}