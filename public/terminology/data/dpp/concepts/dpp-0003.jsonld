{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0003","@type":"skos:Concept","skos:notation":"dpp-0003","skos:prefLabel":{"eng":"unique product identifier"},"skos:definition":{"eng":"unique string of characters for the identification of a product that also enables a web link to the digital product passport"}}