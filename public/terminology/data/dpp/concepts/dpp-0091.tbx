  <text>
    <body>
      <conceptEntry id="dpp-0091">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>service that allows for interaction with resources via a stateless, client-server architecture, typically using standard HTTP calls like GET, POST, PUT, and DELETE to perform methods (3.3) by an application component on these resources</p>
          </descrip>
          <ref>EN 18222:2026 3.1.1</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
