{"@context":"https://glossarist.org/ns/context.jsonld","@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0082","@type":"gl:Concept","gl:identifier":"dpp-0082","gl:localizedConcept":{"eng":{"@id":"https://www.glossarist.org/dpp/dpp/concept/dpp-0082/eng","@type":"gl:LocalizedConcept","gl:languageCode":"eng","gl:designation":[{"@type":"gl:Expression","gl:normativeStatus":"preferred","gl:term":"claim"}],"gl:definition":[{"@type":"gl:DetailedDefinition","gl:content":"high-level statement about a characteristic of a product, or about a process or an organization associated with that product (traceable asset). A sustainability claim is a claim that covers one or multiple sustainability dimensions (economic, environmental, social)"}],"gl:notes":[{"@type":"gl:DetailedDefinition","gl:content":"In this document “sustainability claims” are referred to as just “claims”."}],"gl:source":[{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"CWA 18291:2025","gl:id":"3.1"}}},{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:sourceStatus":"identical","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"UNECE Recommendation No. 46"}}}]}},"gl:status":"valid","gl:domain":[{"@type":"gl:ConceptReference","gl:conceptId":"section-trust-and-verification","gl:source":"urn:unidpp:dpp","gl:refType":"section"}]}