    <body>
      <conceptEntry id="dpp-0112">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>well-defined element associated with a property instance or SubmodelElement, restricting the value statement to a certain period of time or use case</p>
          </descrip>
          <note type="note">Qualifiers can have associated values.</note>
          <ref>IDTA-01001-3.2:2026 (Specification of the Asset Administration Shell — Part 1: Metamodel) 1.1.19</ref>
          <ref>IEC 62569-1</ref>
      </languageSection>
      </conceptEntry>
    </body>
