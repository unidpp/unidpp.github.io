{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0127","@type":"skos:Concept","skos:notation":"dpp-0127","skos:prefLabel":{"eng":"lens"},"skos:definition":{"eng":"profile conceived as a calibrated measuring instrument placed on the digital twin, which selects and transforms without altering the observed scene"},"skos:scopeNote":{"eng":"The mount — the profile interface on the neutral core — is the standardized element: any registered lens by any maker attaches to it."}}