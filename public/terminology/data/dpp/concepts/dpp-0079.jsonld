{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0079","@type":"skos:Concept","skos:notation":"dpp-0079","skos:prefLabel":{"eng":"RTO"},"skos:altLabel":{"eng":"Recovery Time Objective"},"skos:definition":{"eng":"period of time within which minimum levels of services and/or products and the supporting systems, applications, or functions must be recovered after a disruption has occurred"}}