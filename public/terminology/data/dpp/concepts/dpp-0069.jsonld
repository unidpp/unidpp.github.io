{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0069","@type":"skos:Concept","skos:notation":"dpp-0069","skos:prefLabel":{"eng":"traceability system"},"skos:definition":{"eng":"practical system of processes, procedures and information exchanges that implements traceability"}}