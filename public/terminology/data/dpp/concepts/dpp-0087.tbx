<?xml version="1.0" encoding="UTF-8"?>
<tbx style="dca" type="TBX-Basic" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
  <tbxHeader>
    <fileDesc>
      <source>https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0087</source>
    </fileDesc>
  </tbxHeader>
  <text>
    <body>
      <conceptEntry id="dpp-0087">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>capability of two or more entities to exchange items in accordance with a set of rules and mechanisms implemented by an interface in each entity, in order to perform their specified tasks</p>
          </descrip>
          <note type="note">EN 18219:2026 defines “interoperability” from ISO/IEC 22123-1:2023 with a different formulation; see concept dpp-0086.</note>
          <ref>EN 18223:2026 3.1</ref>
          <ref>ISO 18435-1:2009 3.12</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
