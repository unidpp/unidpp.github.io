{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0137","@type":"skos:Concept","skos:notation":"dpp-0137","skos:prefLabel":{"eng":"escrowed disclosure"},"skos:definition":{"eng":"edge visibility arrangement in which information concealed by a blind edge (concept dpp-0136) is deposited with a threshold trustee and released only through a disclosure ceremony — court, regulator or consent"},"skos:scopeNote":{"eng":"The installation schema records escrow as none or trustee, with declared audiences."}}