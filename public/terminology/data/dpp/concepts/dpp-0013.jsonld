{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0013","@type":"skos:Concept","skos:notation":"dpp-0013","skos:prefLabel":{"eng":"persistence"},"skos:definition":{"eng":"process to keep a unique identifier associated with an identified object throughout its life cycle"}}