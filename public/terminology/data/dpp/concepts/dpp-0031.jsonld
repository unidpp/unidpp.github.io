{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0031","@type":"skos:Concept","skos:notation":"dpp-0031","skos:prefLabel":{"eng":"identifier"},"skos:definition":{"eng":"identity information that unambiguously distinguishes one entity from another one in a given domain"},"skos:scopeNote":{"eng":"There are specific identifiers, e.g. UUID Universal unique identifier, IEC 15418 (GS1)."}}