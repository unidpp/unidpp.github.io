{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0121","@type":"skos:Concept","skos:notation":"dpp-0121","skos:prefLabel":{"eng":"type asset"},"skos:definition":{"eng":"(abstract) representation of a set of instance assets with common characteristics and features"},"skos:scopeNote":{"eng":"The set of instance assets may exist or may not exist."}}