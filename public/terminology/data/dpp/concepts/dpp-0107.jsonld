{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0107","@type":"skos:Concept","skos:notation":"dpp-0107","skos:prefLabel":{"eng":"explicit value"},"skos:definition":{"eng":"commonly used concept, like numbers (e.g. 109, 25) which do not need lookup in dictionaries"}}