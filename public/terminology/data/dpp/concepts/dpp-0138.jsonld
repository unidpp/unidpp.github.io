{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0138","@type":"skos:Concept","skos:notation":"dpp-0138","skos:prefLabel":{"eng":"proof of binding"},"skos:definition":{"eng":"salted cryptographic commitment to the parent, recorded in the child's event log, by which a child satisfies the bidirectional parent-knowledge requirement without disclosing the identity of the parent"},"skos:scopeNote":{"eng":"Proof of binding is distinct from knowledge of parent: verifiable modes establish that the child is validly installed in some parent under a given profile (warranty, compliance) without revealing which parent; full disclosure occurs only by ceremony."}}