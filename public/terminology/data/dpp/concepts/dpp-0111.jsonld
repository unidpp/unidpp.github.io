{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0111","@type":"skos:Concept","skos:notation":"dpp-0111","skos:prefLabel":{"eng":"property"},"skos:definition":{"eng":"defined characteristic suitable for the description and differentiation of products or components"},"skos:scopeNote":{"eng":"The concept of type and instance applies to properties."}}