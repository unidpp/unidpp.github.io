@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0055>
  a skos:Concept ;
  skos:notation "dpp-0055" ;
  skos:prefLabel "recycler"@eng ;
  skos:definition "company or company function that performs activities to obtain recovered resources for use in a process or a product, excluding energy recovery"@eng ;
  skos:scopeNote "Activities to obtain resources include activities such as recovery, collection, transport, sorting, cleaning, and re-processing."@eng ;
  skos:scopeNote "Recycling does not include reuse."@eng
 .