{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0133","@type":"skos:Concept","skos:notation":"dpp-0133","skos:prefLabel":{"eng":"active twin"},"skos:definition":{"eng":"digital twin in which the object self-reports under device keys, making truth near-continuous, freshness bounded and detectable, and shifting the binding question from who saw the object to who attests the sensor"},"skos:scopeNote":{"eng":"Corresponds to capability classes S2 (logged contact) and S3 (connected)."}}