  <text>
    <body>
      <conceptEntry id="dpp-0109">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>specific asset that is uniquely identifiable</p>
          </descrip>
          <note type="example">Examples of instance assets are material, a product, a part, a device, a machine, software, a control system, or a production system.</note>
          <ref>IDTA-01001-3.2:2026 (Specification of the Asset Administration Shell — Part 1: Metamodel) 1.1.16</ref>
          <ref>IEC 63278-1:2023</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
