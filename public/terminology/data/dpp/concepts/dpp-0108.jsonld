{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0108","@type":"skos:Concept","skos:notation":"dpp-0108","skos:prefLabel":{"eng":"instance"},"skos:definition":{"eng":"concrete, clearly identifiable component of a certain type"},"skos:scopeNote":{"eng":"An individual entity of a type, for example a device, is obtained by defining specific property values."}}