{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0126","@type":"skos:Concept","skos:notation":"dpp-0126","skos:prefLabel":{"eng":"projection"},"skos:definition":{"eng":"deterministic, registered and legally cited view of the testimonial record of a governed digital twin, computed under a profile from the event-sourced change log"},"skos:scopeNote":{"eng":"The passport is the legal materialized view of the twin; the twin is the source of truth."}}