{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0070","@type":"skos:Concept","skos:notation":"dpp-0070","skos:prefLabel":{"eng":"traceable asset"},"skos:definition":{"eng":"traceable asset is any product or material (individually, in batches, or in trade units) that needs to be tracked along a value chain"}}