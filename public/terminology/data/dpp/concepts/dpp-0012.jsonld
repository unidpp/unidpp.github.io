{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0012","@type":"skos:Concept","skos:notation":"dpp-0012","skos:prefLabel":{"eng":"self-issuing system"},"skos:altLabel":{"eng":"decentralized identification scheme"},"skos:definition":{"eng":"system or mechanism that an organization uses to generate and assign unique identifiers to its objects without the intervention or oversight of an external authority"}}