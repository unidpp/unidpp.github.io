{"@context":"https://glossarist.org/ns/context.jsonld","@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0007","@type":"gl:Concept","gl:identifier":"dpp-0007","gl:localizedConcept":{"eng":{"@id":"https://www.glossarist.org/dpp/dpp/concept/dpp-0007/eng","@type":"gl:LocalizedConcept","gl:languageCode":"eng","gl:designation":[{"@type":"gl:Expression","gl:normativeStatus":"preferred","gl:term":"Unique Identifier"}],"gl:definition":[{"@type":"gl:DetailedDefinition","gl:content":"identifier which is guaranteed to be unique among all identifiers used for those objects and for a specific purpose"}],"gl:notes":[{"@type":"gl:DetailedDefinition","gl:content":"For more information, see ISO/IEC 15459-1."},{"@type":"gl:DetailedDefinition","gl:content":"Harmonization note (UniDPP): EN 18219:2026 and EN 18220:2026 define “unique identifier” as a string of characters required to be unique; see concept dpp-0006."}],"gl:source":[{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"CWA 18291:2025","gl:id":"3.3"}}},{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"ISO 29404:2015","gl:id":"3.26"}}}]}},"gl:status":"valid","gl:domain":[{"@type":"gl:ConceptReference","gl:conceptId":"section-identity-and-carriers","gl:source":"urn:unidpp:dpp","gl:refType":"section"}]}