{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0039","@type":"skos:Concept","skos:notation":"dpp-0039","skos:prefLabel":{"eng":"notified actor"},"skos:definition":{"eng":"organization or individual entitled by an authorized accrediting body or authority, that fulfils a role in the DPP lifecycle"}}