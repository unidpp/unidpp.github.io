<?xml version="1.0" encoding="UTF-8"?>
<tbx style="dca" type="TBX-Basic" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
  <tbxHeader>
    <fileDesc>
      <source>https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0007</source>
    </fileDesc>
  </tbxHeader>
  <text>
    <body>
      <conceptEntry id="dpp-0007">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>identifier which is guaranteed to be unique among all identifiers used for those objects and for a specific purpose</p>
          </descrip>
          <note type="note">For more information, see ISO/IEC 15459-1.</note>
          <note type="note">EN 18219:2026 and EN 18220:2026 define “unique identifier” as a string of characters required to be unique; see concept dpp-0006.</note>
          <ref>CWA 18291:2025 3.3</ref>
          <ref>ISO 29404:2015 3.26</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
