{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0110","@type":"skos:Concept","skos:notation":"dpp-0110","skos:prefLabel":{"eng":"operation"},"skos:definition":{"eng":"executable realization of a function"},"skos:scopeNote":{"eng":"The term method is synonymous to operation."}}