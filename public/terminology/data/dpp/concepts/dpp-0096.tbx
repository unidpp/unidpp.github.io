      <conceptEntry id="dpp-0096">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>software functional element specific to the solution of a problem in industrial-process measurement and control</p>
          </descrip>
          <note type="note">An application can be distributed among resources and may communicate with other applications.</note>
          <ref>IDTA-01001-3.2:2026 (Specification of the Asset Administration Shell — Part 1: Metamodel) 1.1.2</ref>
          <ref>IEC TR 62390:2005-01 3.1.2</ref>
