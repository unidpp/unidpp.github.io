<tbx style="dca" type="TBX-Basic" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
  <tbxHeader>
    <fileDesc>
      <source>https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0082</source>
    </fileDesc>
  </tbxHeader>
  <text>
    <body>
      <conceptEntry id="dpp-0082">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>high-level statement about a characteristic of a product, or about a process or an organization associated with that product (traceable asset). A sustainability claim is a claim that covers one or multiple sustainability dimensions (economic, environmental, social)</p>
          </descrip>
          <note type="note">In this document “sustainability claims” are referred to as just “claims”.</note>
          <ref>CWA 18291:2025 3.1</ref>
          <ref>UNECE Recommendation No. 46</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
