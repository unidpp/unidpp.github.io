{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0128","@type":"skos:Concept","skos:notation":"dpp-0128","skos:prefLabel":{"eng":"stamp"},"skos:definition":{"eng":"lens-scoped attestation consisting of an attester signature over the subject, the subject state commitment, the lens identity and version, the mode (live or snapshot), a verdict with coverage report, and log-anchored time"},"skos:scopeNote":{"eng":"Stamps accrete append-only and are valid under the stamper's lens regardless of the issuer's."}}