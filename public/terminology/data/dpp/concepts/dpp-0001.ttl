@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0001>
  a skos:Concept ;
  skos:notation "dpp-0001" ;
  skos:prefLabel "digital product passport"@eng ;
  skos:prefLabel "DPP"@eng ;
  skos:definition "digital record of product characteristics throughout its life cycle"@eng ;
  skos:scopeNote "Example characteristics include environmental sustainability, environmental impact, and recyclability."@eng ;
  skos:scopeNote "Harmonization note (UniDPP): the variant of this definition extended by accessibility via electronic means through a data carrier is recorded under concept dpp-0004."@eng
 .