{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0076","@type":"skos:Concept","skos:notation":"dpp-0076","skos:prefLabel":{"eng":"system availability"},"skos:definition":{"eng":"property of being accessible and usable on demand by an authorized entity"}}