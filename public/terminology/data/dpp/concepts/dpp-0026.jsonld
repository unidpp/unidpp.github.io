{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0026","@type":"skos:Concept","skos:notation":"dpp-0026","skos:prefLabel":{"eng":"two-dimensional symbol"},"skos:definition":{"eng":"code representing data in machine-readable form by a collection of polygonal or circular cells in a regular pattern which are read optically by scanning"}}