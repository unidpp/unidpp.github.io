{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0091","@type":"skos:Concept","skos:notation":"dpp-0091","skos:prefLabel":{"eng":"representational state transfer application programming interface"},"skos:altLabel":{"eng":"REST API"},"skos:definition":{"eng":"service that allows for interaction with resources via a stateless, client-server architecture, typically using standard HTTP calls like GET, POST, PUT, and DELETE to perform methods (3.3) by an application component on these resources"}}