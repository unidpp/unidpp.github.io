{"@context":"https://glossarist.org/ns/context.jsonld","@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0071","@type":"gl:Concept","gl:identifier":"dpp-0071","gl:localizedConcept":{"eng":{"@id":"https://www.glossarist.org/dpp/dpp/concept/dpp-0071/eng","@type":"gl:LocalizedConcept","gl:languageCode":"eng","gl:designation":[{"@type":"gl:Expression","gl:normativeStatus":"preferred","gl:term":"textile product"},{"@type":"gl:Expression","gl:normativeStatus":"admitted","gl:term":"product"}],"gl:definition":[{"@type":"gl:DetailedDefinition","gl:content":"product made mainly of textile fibres, yarns and/or fabrics and intended to be used, as such or in conjunction with other textile or non-textile elements"}],"gl:notes":[{"@type":"gl:DetailedDefinition","gl:content":"These articles can contain non-textile parts, such as plastics (e.g. buttons and membrane or coatings) or metals."},{"@type":"gl:DetailedDefinition","gl:content":"Source entry heading: “textile product – product”."}],"gl:source":[{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"CWA 18291:2025","gl:id":"3.4"}}},{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"ISO 5157:2023"}}}]}},"gl:status":"valid","gl:domain":[{"@type":"gl:ConceptReference","gl:conceptId":"section-lifecycle-and-events","gl:source":"urn:unidpp:dpp","gl:refType":"section"}]}