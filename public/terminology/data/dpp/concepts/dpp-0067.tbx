    <body>
      <conceptEntry id="dpp-0067">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>system by which products or resources are used and then recovered and turned into new products or recovered resources, without losing their inherent properties</p>
          </descrip>
          <ref>CWA 18291:2025 3.25</ref>
          <ref>ISO 59004:2024</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
