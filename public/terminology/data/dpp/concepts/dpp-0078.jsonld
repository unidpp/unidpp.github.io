{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0078","@type":"skos:Concept","skos:notation":"dpp-0078","skos:prefLabel":{"eng":"recovery point objective"},"skos:altLabel":{"eng":"RPO"},"skos:definition":{"eng":"point in time to which data must be recovered after a disruption has occurred"}}