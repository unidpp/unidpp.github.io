{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0096","@type":"skos:Concept","skos:notation":"dpp-0096","skos:prefLabel":{"eng":"application"},"skos:definition":{"eng":"software functional element specific to the solution of a problem in industrial-process measurement and control"},"skos:scopeNote":{"eng":"An application can be distributed among resources and may communicate with other applications."}}