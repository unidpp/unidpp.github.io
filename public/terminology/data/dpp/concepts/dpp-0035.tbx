    <body>
      <conceptEntry id="dpp-0035">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>digital product passport service provider (3.3) that is hosting the digital product passport (3.2) on behalf of the economic operator (3.1) if the economic operator chooses not to host the digital product passport themselves</p>
          </descrip>
          <ref>EN 18221:2026 3.3.1</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
