{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0024","@type":"skos:Concept","skos:notation":"dpp-0024","skos:prefLabel":{"eng":"radio-frequency identification"},"skos:definition":{"eng":"identification technology that uses electromagnetic fields to automatically identify and track tags attached to objects"}}