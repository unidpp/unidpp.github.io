{"@context":"https://glossarist.org/ns/context.jsonld","@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0032","@type":"gl:Concept","gl:identifier":"dpp-0032","gl:localizedConcept":{"eng":{"@id":"https://www.glossarist.org/dpp/dpp/concept/dpp-0032/eng","@type":"gl:LocalizedConcept","gl:languageCode":"eng","gl:designation":[{"@type":"gl:Expression","gl:normativeStatus":"preferred","gl:term":"economic operator"}],"gl:definition":[{"@type":"gl:DetailedDefinition","gl:content":"manufacturer, authorized representative, importer, distributor, dealer or fulfilment service provider that places the product on the market"}],"gl:notes":[{"@type":"gl:DetailedDefinition","gl:content":"EN 18221:2026 defines “economic operator” without the placing-on-the-market qualifier; see concept dpp-0033."}],"gl:source":[{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"EN 18219:2026","gl:id":"3.1.5"}}},{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:sourceStatus":"similar","gl:modification":"The source prints “places the product onto the market”; the definition is equivalent.","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"EN 18220:2026","gl:id":"3.7"}}}]}},"gl:status":"valid","gl:schemaVersion":"3","gl:domain":[{"@type":"gl:ConceptReference","gl:conceptId":"section-actors-and-issuance","gl:source":"urn:unidpp:dpp","gl:refType":"section"}]}