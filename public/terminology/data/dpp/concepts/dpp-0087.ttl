@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0087>
  a skos:Concept ;
  skos:notation "dpp-0087" ;
  skos:prefLabel "interoperability"@eng ;
  skos:definition "capability of two or more entities to exchange items in accordance with a set of rules and mechanisms implemented by an interface in each entity, in order to perform their specified tasks"@eng ;
  skos:scopeNote "Harmonization note (UniDPP): EN 18219:2026 defines “interoperability” from ISO/IEC 22123-1:2023 with a different formulation; see concept dpp-0086."@eng
 .