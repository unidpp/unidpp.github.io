{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0022","@type":"skos:Concept","skos:notation":"dpp-0022","skos:prefLabel":{"eng":"barcode"},"skos:definition":{"eng":"printed data carrier indicating either a reference to a linear or a 2D matrix"},"skos:scopeNote":{"eng":"It excludes RFID data carriers."}}