{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0046","@type":"skos:Concept","skos:notation":"dpp-0046","skos:prefLabel":{"eng":"subcontractor"},"skos:definition":{"eng":"company or company function that performs activities as a sub-contractor (for example cutting/sewing operations but also dyeing)"}}