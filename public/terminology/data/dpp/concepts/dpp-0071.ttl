  a skos:Concept ;
  skos:notation "dpp-0071" ;
  skos:prefLabel "textile product"@eng ;
  skos:altLabel "product"@eng ;
  skos:definition "product made mainly of textile fibres, yarns and/or fabrics and intended to be used, as such or in conjunction with other textile or non-textile elements"@eng ;
  skos:scopeNote "These articles can contain non-textile parts, such as plastics (e.g. buttons and membrane or coatings) or metals."@eng ;
  skos:scopeNote "Source entry heading: “textile product – product”."@eng
