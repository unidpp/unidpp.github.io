{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0082","@type":"skos:Concept","skos:notation":"dpp-0082","skos:prefLabel":{"eng":"claim"},"skos:definition":{"eng":"high-level statement about a characteristic of a product, or about a process or an organization associated with that product (traceable asset). A sustainability claim is a claim that covers one or multiple sustainability dimensions (economic, environmental, social)"},"skos:scopeNote":{"eng":"In this document “sustainability claims” are referred to as just “claims”."}}