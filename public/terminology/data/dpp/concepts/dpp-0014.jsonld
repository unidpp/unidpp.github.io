{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0014","@type":"skos:Concept","skos:notation":"dpp-0014","skos:prefLabel":{"eng":"preservation"},"skos:definition":{"eng":"activity of ensuring that a unique identifier and its denotation remain stable, valid, and retrievable for as long as required"}}