{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0020","@type":"skos:Concept","skos:notation":"dpp-0020","skos:prefLabel":{"eng":"data carrier"},"skos:definition":{"eng":"device or medium used to store data as a relay mechanism in an automatic identification and data capture system"}}