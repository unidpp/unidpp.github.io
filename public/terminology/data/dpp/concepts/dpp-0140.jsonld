{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0140","@type":"skos:Concept","skos:notation":"dpp-0140","skos:prefLabel":{"eng":"predicate-based recall"},"skos:definition":{"eng":"recall scheme in which the recall set is never enumerated centrally: the recall predicate is published, and each custodian evaluates it locally against their own holdings — including dark and defence holdings under national procedure — and acts"},"skos:scopeNote":{"eng":"The manufacturer receives aggregates or nothing; there is no traversal-push enumeration of the installed base."}}