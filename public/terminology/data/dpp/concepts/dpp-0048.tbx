  <text>
    <body>
      <conceptEntry id="dpp-0048">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>company or company function that produces final or non-final fashion products (yarns, fabrics, garments, accessories, footwear, etc.); its industrial process has in input materials and in output components or final fashion goods for the business customers or final customers</p>
          </descrip>
          <ref>CWA 18291:2025 3.14</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
