{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0071","@type":"skos:Concept","skos:notation":"dpp-0071","skos:prefLabel":{"eng":"textile product"},"skos:altLabel":{"eng":"product"},"skos:definition":{"eng":"product made mainly of textile fibres, yarns and/or fabrics and intended to be used, as such or in conjunction with other textile or non-textile elements"},"skos:scopeNote":{"eng":"These articles can contain non-textile parts, such as plastics (e.g. buttons and membrane or coatings) or metals."}}