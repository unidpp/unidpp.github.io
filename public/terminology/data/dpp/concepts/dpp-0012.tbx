    <body>
      <conceptEntry id="dpp-0012">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>system or mechanism that an organization uses to generate and assign unique identifiers to its objects without the intervention or oversight of an external authority</p>
          </descrip>
          <ref>EN 18219:2026 3.1.20</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
