{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0041","@type":"skos:Concept","skos:notation":"dpp-0041","skos:prefLabel":{"eng":"customer"},"skos:definition":{"eng":"organization or person that receives a product"},"skos:scopeNote":{"eng":"The customer may be the user or a distributor [SOURCE: ISO 9000]."}}