<tbx style="dca" type="TBX-Basic" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
  <tbxHeader>
    <fileDesc>
      <source>https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0064</source>
    </fileDesc>
  </tbxHeader>
  <text>
    <body>
      <conceptEntry id="dpp-0064">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>point in time during the life cycle at which a product or resource is transferred by the holder to some other holder</p>
          </descrip>
          <note type="example">When an organization (e.g., shop or retailer) in possession of the product considers it to be a waste since it hasn't or can't be sold.</note>
          <ref>CWA 18291:2025 3.26</ref>
          <ref>ISO 59004:2024</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
