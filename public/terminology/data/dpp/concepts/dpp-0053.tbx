  <text>
    <body>
      <conceptEntry id="dpp-0053">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>person or a system that categorizes discarded textile materials by their fibre composition, color, and condition to determine their potential for reuse, repair, or recycling</p>
          </descrip>
          <ref>CWA 18291:2025 3.19</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
