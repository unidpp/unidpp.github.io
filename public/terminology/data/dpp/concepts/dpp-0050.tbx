    <body>
      <conceptEntry id="dpp-0050">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>company or company function that produces yarns from raw material; it has mainly Fabric and Knitwear producers as customers (Apparel Producers sometimes)</p>
          </descrip>
          <ref>CWA 18291:2025 3.16</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
