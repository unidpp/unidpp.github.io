{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0033","@type":"skos:Concept","skos:notation":"dpp-0033","skos:prefLabel":{"eng":"economic operator"},"skos:definition":{"eng":"manufacturer, authorized representative, importer, distributor, dealer or fulfilment service provider"},"skos:scopeNote":{"eng":"EN 18219:2026 and EN 18220:2026 add the qualifier “that places the product on the market”; see concept dpp-0032."}}