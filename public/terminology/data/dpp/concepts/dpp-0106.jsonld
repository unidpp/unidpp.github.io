{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0106","@type":"skos:Concept","skos:notation":"dpp-0106","skos:prefLabel":{"eng":"digital twin"},"skos:definition":{"eng":"digital representation, sufficient to meet the requirements of a set of use cases"},"skos:scopeNote":{"eng":"In this context, the entity in the definition of digital representation is typically an asset."}}