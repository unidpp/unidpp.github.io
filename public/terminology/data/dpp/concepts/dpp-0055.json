{"@context":"https://glossarist.org/ns/context.jsonld","@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0055","@type":"gl:Concept","gl:identifier":"dpp-0055","gl:localizedConcept":{"eng":{"@id":"https://www.glossarist.org/dpp/dpp/concept/dpp-0055/eng","@type":"gl:LocalizedConcept","gl:languageCode":"eng","gl:designation":[{"@type":"gl:Expression","gl:normativeStatus":"preferred","gl:term":"recycler"}],"gl:definition":[{"@type":"gl:DetailedDefinition","gl:content":"company or company function that performs activities to obtain recovered resources for use in a process or a product, excluding energy recovery"}],"gl:notes":[{"@type":"gl:DetailedDefinition","gl:content":"Activities to obtain resources include activities such as recovery, collection, transport, sorting, cleaning, and re-processing."},{"@type":"gl:DetailedDefinition","gl:content":"Recycling does not include reuse."}],"gl:source":[{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"CWA 18291:2025","gl:id":"3.22"}}},{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:sourceStatus":"identical","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"ISO 59004:2024"}}}]}},"gl:status":"valid","gl:schemaVersion":"3","gl:domain":[{"@type":"gl:ConceptReference","gl:conceptId":"section-actors-and-issuance","gl:source":"urn:unidpp:dpp","gl:refType":"section"}]}