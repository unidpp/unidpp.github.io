{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0132","@type":"skos:Concept","skos:notation":"dpp-0132","skos:prefLabel":{"eng":"passive twin"},"skos:definition":{"eng":"digital twin reconstructed from point-in-time attestations about the object, sampled when the object visits an attestor, in which truth is episodic and staleness between attestations is unbounded and undetectable"},"skos:scopeNote":{"eng":"Corresponds to capability classes S0 (silent, testimony-only) and S1 (passive authentication)."}}