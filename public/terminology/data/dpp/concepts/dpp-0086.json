{"@context":"https://glossarist.org/ns/context.jsonld","@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0086","@type":"gl:Concept","gl:identifier":"dpp-0086","gl:localizedConcept":{"eng":{"@id":"https://www.glossarist.org/dpp/dpp/concept/dpp-0086/eng","@type":"gl:LocalizedConcept","gl:languageCode":"eng","gl:designation":[{"@type":"gl:Expression","gl:normativeStatus":"preferred","gl:term":"interoperability"}],"gl:definition":[{"@type":"gl:DetailedDefinition","gl:content":"ability of two or more systems or applications to exchange information and to mutually use the information that has been exchanged"}],"gl:source":[{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:sourceStatus":"identical","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"ISO/IEC 22123-1:2023","gl:id":"3.6.1"}}},{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:sourceStatus":"identical","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"EN 18219:2026","gl:id":"3.1.7"}}},{"@type":"gl:ConceptSource","gl:sourceType":"authoritative","gl:sourceStatus":"modified","gl:modification":"EN 18223:2026 adopts the ISO 18435-1:2009 3.12 formulation: “capability of two or more entities to exchange items in accordance with a set of rules and mechanisms implemented by an interface in each entity, in order to perform their specified tasks”.","gl:origin":{"@type":"gl:Citation","gl:ref":{"@type":"gl:Ref","gl:source":"EN 18223:2026","gl:id":"3.1"}}}]}},"gl:status":"valid","gl:schemaVersion":"3","gl:domain":[{"@type":"gl:ConceptReference","gl:conceptId":"section-semantics-and-profiles","gl:source":"urn:unidpp:dpp","gl:refType":"section"}]}