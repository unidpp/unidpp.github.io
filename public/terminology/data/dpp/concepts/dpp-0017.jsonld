{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0017","@type":"skos:Concept","skos:notation":"dpp-0017","skos:prefLabel":{"eng":"unique economic operator identifier"},"skos:definition":{"eng":"unique string of characters for the identification of an actors involved in a product's value chain"},"skos:scopeNote":{"eng":"The source prints “an actors”; the definition is reproduced verbatim."}}