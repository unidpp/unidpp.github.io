{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0036","@type":"skos:Concept","skos:notation":"dpp-0036","skos:prefLabel":{"eng":"back-up digital product passport service provider"},"skos:definition":{"eng":"digital product passport service provider (3.3) that is hosting the back-up copy of the digital product passport (3.2)"}}