{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0090","@type":"skos:Concept","skos:notation":"dpp-0090","skos:prefLabel":{"eng":"application programming interface"},"skos:definition":{"eng":"set of methods (3.3) provided by an application component for use by other application components"}}