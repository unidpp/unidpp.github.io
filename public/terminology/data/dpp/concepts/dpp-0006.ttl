@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0006>
  a skos:Concept ;
  skos:notation "dpp-0006" ;
  skos:prefLabel "unique identifier"@eng ;
  skos:definition "string of characters that is required to be unique among all identifiers used for all objects for a specific purpose"@eng ;
  skos:scopeNote "A unique identifier refers to unique product identifier (3.1.25), unique economic operator identifier (3.1.22), and unique facility identifier (3.1.23)."@eng ;
  skos:scopeNote "Harmonization note (UniDPP): CWA 18291:2025 defines “Unique Identifier” as an identifier which is guaranteed to be unique; see concept dpp-0007."@eng
 .