{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0021","@type":"skos:Concept","skos:notation":"dpp-0021","skos:prefLabel":{"eng":"additional software"},"skos:definition":{"eng":"additional application, program, or tool that a user will install or access separately from the default setup of most smartphones or similar devices to interact with the digital product passport"},"skos:scopeNote":{"eng":"Standard functionalities, such as web browsers, camera-based QR readers, and universal communication protocols (e.g. DNS, HTTP, HTTPS), are not considered as additional software."}}