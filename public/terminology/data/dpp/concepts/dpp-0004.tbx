<?xml version="1.0" encoding="UTF-8"?>
<tbx style="dca" type="TBX-Basic" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
  <tbxHeader>
    <fileDesc>
      <source>https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0004</source>
    </fileDesc>
  </tbxHeader>
  <text>
    <body>
      <conceptEntry id="dpp-0004">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>digital record of product characteristics throughout its life cycle that is accessible via electronic means through a data carrier</p>
          </descrip>
          <note type="note">Example characteristics include environmental sustainability, environmental impact, and recyclability.</note>
          <note type="note">Harmonization note (UniDPP): EN 18219:2026 and EN 18220:2026 extend the definition by accessibility through a data carrier; the shorter formulation shared by EN 18216:2026, EN 18221:2026, EN 18222:2026, EN 18223:2026, EN 18239 and EN 18246 is recorded under concept dpp-0001, where the definitional conflict with ISO/AWI 25534-1 is also annotated.</note>
          <ref>EN 18219:2026 3.1.3</ref>
          <ref>EN 18220:2026 3.6</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
