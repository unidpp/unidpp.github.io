{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0130","@type":"skos:Concept","skos:notation":"dpp-0130","skos:prefLabel":{"eng":"derived passport"},"skos:definition":{"eng":"passport issued as the output of a transformation event by an actor accredited for the regulated claims it contains, hash-linking its input passports"},"skos:scopeNote":{"eng":"Only accredited actors may issue derived passports for regulated claims (the notified-actor pattern of EN 18239)."}}