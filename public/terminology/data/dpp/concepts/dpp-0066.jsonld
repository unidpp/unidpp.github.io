{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0066","@type":"skos:Concept","skos:notation":"dpp-0066","skos:prefLabel":{"eng":"collection"},"skos:definition":{"eng":"process of gathering and transporting used textile products or waste materials to a sorting facility for further processing such as reuse, repair, remanufacturing, or recycling"}}