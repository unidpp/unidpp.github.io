@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0085>
  a skos:Concept ;
  skos:notation "dpp-0085" ;
  skos:prefLabel "electronically signed data construct"@eng ;
  skos:altLabel "ESDC"@eng ;
  skos:definition "structured data set containing the header, payload, signature and optional data fields"@eng ;
  skos:scopeNote "The payload type and issuer identity are included in the header."@eng ;
  skos:scopeNote "An ESDC is a machine-readable code."@eng ;
  skos:scopeNote "An ESDC can contain non-signed data elements."@eng
 .