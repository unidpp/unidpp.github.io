{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0027","@type":"skos:Concept","skos:notation":"dpp-0027","skos:prefLabel":{"eng":"X dimension"},"skos:definition":{"eng":"specified width of the narrow in a bar code symbol or the specified width of a single element in a two-dimensional symbol"}}