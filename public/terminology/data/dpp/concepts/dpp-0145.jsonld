{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0145","@type":"skos:Concept","skos:notation":"dpp-0145","skos:prefLabel":{"eng":"truth mode"},"skos:definition":{"eng":"declared per-data-element attribute of a profile stating which truth source the element requires — attest-sampled, self-committed, or both with a precedence rule"},"skos:scopeNote":{"eng":"The passive twin (concept dpp-0132) supplies attest-sampled truth and the active twin (concept dpp-0133) supplies self-committed truth; both paradigms coexist permanently in the framework."}}