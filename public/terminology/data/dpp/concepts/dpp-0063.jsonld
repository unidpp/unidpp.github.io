{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0063","@type":"skos:Concept","skos:notation":"dpp-0063","skos:prefLabel":{"eng":"digital product passport lifetime"},"skos:definition":{"eng":"period during which the digital product passport (3.2) is required by regulation to be available to any operator or natural or legal person with a right to access its data"}}