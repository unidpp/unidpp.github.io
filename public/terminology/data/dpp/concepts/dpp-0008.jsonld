{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0008","@type":"skos:Concept","skos:notation":"dpp-0008","skos:prefLabel":{"eng":"digital identifier"},"skos:altLabel":{"eng":"identifier"},"skos:definition":{"eng":"sequence of characters associated with digital, non-digital, or abstract entities, such as books, images, reports, metadata records or events"}}