{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0001","@type":"skos:Concept","skos:notation":"dpp-0001","skos:prefLabel":{"eng":"digital product passport"},"skos:altLabel":{"eng":"DPP"},"skos:definition":{"eng":"a concept or technology which enables sharing of product related information that is essential for product sustainability and circularity, including those specified in regulations, across all relevant economic actors"},"skos:scopeNote":{"eng":"Example characteristics include environmental sustainability, environmental impact, and recyclability."}}