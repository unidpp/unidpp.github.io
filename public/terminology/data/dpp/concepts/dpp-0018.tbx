      <conceptEntry id="dpp-0018">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>unique string of characters for the identification of location or building involved in a product's value chain or used by actors involved in a product's value chain</p>
          </descrip>
          <ref>EN 18219:2026 3.1.23</ref>
      </languageSection>
      </conceptEntry>
    </body>
