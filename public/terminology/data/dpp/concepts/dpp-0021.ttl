@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0021>
  a skos:Concept ;
  skos:notation "dpp-0021" ;
  skos:prefLabel "additional software"@eng ;
  skos:definition "additional application, program, or tool that a user will install or access separately from the default setup of most smartphones or similar devices to interact with the digital product passport"@eng ;
  skos:scopeNote "Standard functionalities, such as web browsers, camera-based QR readers, and universal communication protocols (e.g. DNS, HTTP, HTTPS), are not considered as additional software."@eng
 .