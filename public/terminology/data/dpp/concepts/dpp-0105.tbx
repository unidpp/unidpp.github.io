<?xml version="1.0" encoding="UTF-8"?>
<tbx style="dca" type="TBX-Basic" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
  <tbxHeader>
    <fileDesc>
      <source>https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0105</source>
    </fileDesc>
  </tbxHeader>
  <text>
    <body>
      <conceptEntry id="dpp-0105">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>information and services representing an entity from a given viewpoint</p>
          </descrip>
          <note type="example">Examples of information are properties (e.g. maximum temperature), actual parameters (e.g. actual velocity), events (e.g. notification of status change), schematics (electrical), and visualization information (2D and 3D drawings).</note>
          <note type="example">Examples of services are asset services (for example providing the history of the configuration data or providing the actual velocity) and asset related services (for example providing a simulation).</note>
          <note type="example">Examples of viewpoints are mechanical, electrical, or commercial characteristics.</note>
          <ref>IDTA-01001-3.2:2026 (Specification of the Asset Administration Shell — Part 1: Metamodel) 1.1.11</ref>
          <ref>IEC 63278-1:2023</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
