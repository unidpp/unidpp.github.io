{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0004","@type":"skos:Concept","skos:notation":"dpp-0004","skos:prefLabel":{"eng":"digital product passport"},"skos:definition":{"eng":"digital record of product characteristics throughout its life cycle that is accessible via electronic means through a data carrier"},"skos:scopeNote":{"eng":"Example characteristics include environmental sustainability, environmental impact, and recyclability."}}