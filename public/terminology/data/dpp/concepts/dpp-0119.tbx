      <conceptEntry id="dpp-0119">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>specification of the common features of an object in sufficient detail that such object can be instantiated using it</p>
          </descrip>
          <note type="note">Object can be anything that has a type.</note>
          <ref>IDTA-01001-3.2:2026 (Specification of the Asset Administration Shell — Part 1: Metamodel) 1.1.26</ref>
