{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0119","@type":"skos:Concept","skos:notation":"dpp-0119","skos:prefLabel":{"eng":"template"},"skos:definition":{"eng":"specification of the common features of an object in sufficient detail that such object can be instantiated using it"},"skos:scopeNote":{"eng":"Object can be anything that has a type."}}