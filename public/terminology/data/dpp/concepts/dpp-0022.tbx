      <conceptEntry id="dpp-0022">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>printed data carrier indicating either a reference to a linear or a 2D matrix</p>
          </descrip>
          <note type="note">It excludes RFID data carriers.</note>
          <ref>EN 18220:2026 3.2</ref>
      </languageSection>
      </conceptEntry>
