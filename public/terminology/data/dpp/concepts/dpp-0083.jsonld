{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0083","@type":"skos:Concept","skos:notation":"dpp-0083","skos:prefLabel":{"eng":"state-of-the-art"},"skos:definition":{"eng":"developed stage of technical capability at a given time as regards products, processes and services, based on the relevant consolidated findings of science, technology and experience"}}