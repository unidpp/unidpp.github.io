    <body>
      <conceptEntry id="dpp-0106">
      <languageSection xml:lang="eng">
          <descrip type="definition">
            <p>digital representation, sufficient to meet the requirements of a set of use cases</p>
          </descrip>
          <note type="note">In this context, the entity in the definition of digital representation is typically an asset.</note>
          <ref>IDTA-01001-3.2:2026 (Specification of the Asset Administration Shell — Part 1: Metamodel) 1.1.12</ref>
          <ref>IIC Vocabulary IIC:IIVOC:V2.3:20201025</ref>
      </languageSection>
      </conceptEntry>
    </body>
  </text>
</tbx>
