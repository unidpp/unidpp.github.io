@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0128>
  a skos:Concept ;
  skos:notation "dpp-0128" ;
  skos:prefLabel "stamp"@eng ;
  skos:definition "lens-scoped attestation consisting of an attester signature over the subject, the subject state commitment, the lens identity and version, the mode (live or snapshot), a verdict with coverage report, and log-anchored time"@eng ;
  skos:scopeNote "Stamps accrete append-only and are valid under the stamper's lens regardless of the issuer's."@eng ;
  skos:scopeNote "Jurisdiction stamps on a foreign-issued passport correspond to visas; entry and exit stamps correspond to verifier custody events."@eng ;
  skos:scopeNote "Stamps may carry quantity context, inherited by downstream transformations."@eng
 .