{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0064","@type":"skos:Concept","skos:notation":"dpp-0064","skos:prefLabel":{"eng":"end-of-use"},"skos:definition":{"eng":"point in time during the life cycle at which a product or resource is transferred by the holder to some other holder"}}