{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0006","@type":"skos:Concept","skos:notation":"dpp-0006","skos:prefLabel":{"eng":"unique identifier"},"skos:definition":{"eng":"identifier which is guaranteed to be unique among all identifiers used for those objects and for a specific purpose"},"skos:scopeNote":{"eng":"A unique identifier refers to unique product identifier (3.1.25), unique economic operator identifier (3.1.22), and unique facility identifier (3.1.23)."}}