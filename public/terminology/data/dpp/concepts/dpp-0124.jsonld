{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0124","@type":"skos:Concept","skos:notation":"dpp-0124","skos:prefLabel":{"eng":"profile"},"skos:definition":{"eng":"registered, versioned object that binds a set of data points, transforms, cryptographic suites, trust requirements, access policies, presentation requirements and a trigger predicate to the neutral core passport, constraining and transforming — but never redefining — the single definition of each data point"},"skos:scopeNote":{"eng":"Composition is three-axial: jurisdiction × sector × characteristic."}}