{"@context":{"skos":"http://www.w3.org/2004/02/skos/core#","dcterms":"http://purl.org/dc/terms/","@language":{"@container":"@language"}},"@id":"https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0065","@type":"skos:Concept","skos:notation":"dpp-0065","skos:prefLabel":{"eng":"end-of-life"},"skos:definition":{"eng":"point in time during the life cycle at which a product or resource is taken out of use and is disposed"},"skos:scopeNote":{"eng":"Disposal could be in the form of incineration, deposit to landfill, or composting."}}