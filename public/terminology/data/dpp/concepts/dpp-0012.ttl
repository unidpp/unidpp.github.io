<https://www.glossarist.org/dpp/dataset/dpp/concept/dpp-0012>
  a skos:Concept ;
  skos:notation "dpp-0012" ;
  skos:prefLabel "self-issuing system"@eng ;
  skos:altLabel "decentralized identification scheme"@eng ;
  skos:definition "system or mechanism that an organization uses to generate and assign unique identifiers to its objects without the intervention or oversight of an external authority"@eng
